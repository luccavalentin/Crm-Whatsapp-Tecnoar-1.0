# O HTTPS é terminado pelo Traefik que já roda na VPS.
# Aqui servimos apenas HTTP interno na porta 80 do container.
:80 {
	root * /srv
	encode zstd gzip

	# Aplicação de página única: qualquer rota volta para o index
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Arquivos com hash no nome podem ficar em cache por muito tempo
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# O index nunca fica em cache, para o deploy aparecer na hora
	@index path /index.html /
	header @index Cache-Control "no-cache"

	# Verificação de saúde
	respond /healthz 200 {
		body "ok"
	}
}
